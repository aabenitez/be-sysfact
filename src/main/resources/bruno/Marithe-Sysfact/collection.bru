auth {
  mode: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  const axios = require("axios");
  
  // Solo hace login si la variable está vacía
  if (!bru.getVar("token")) {
      console.log("No hay token activo. Solicitando uno nuevo...");
      try {
          const response = await axios.post("http://localhost:8080/sysfact/login", {
              username: "alcides.abel.benitez@gmail.com",
              password: "12345"
          }, {
              headers: { "Content-Type": "application/json" }
          });
  
          const token = response.data?.user?.token;
          
          if (token) {
              bru.setVar("token", token);
              console.log("Nuevo token guardado con éxito.");
          }
      } catch (error) {
          console.error("Error en Login automático:", error.message);
      }
  }
}

script:post-response {
  const status = res.getStatus();
  const body = res.getBody();
  
  if (status === 401 || status === 403 || (status === 500 && body?.message?.includes("expired"))) {
      console.log("Token inválido o expirado (401). Limpiando variable...");
      bru.setVar("token", ""); 
  }
}

# Configuración del despliegue de Sysfact.
# Copiá este archivo como config.env (en la misma carpeta) y completá los valores.
# config.env no se sube a git.

# --- Servidor (VPS) ---
# Usuario con sudo e IP o nombre del VPS, tal como lo usás con ssh.
SERVIDOR="usuario@203.0.113.10"
# Puerto SSH del VPS.
SSH_PUERTO="22"

# --- Dominio y HTTPS ---
# Dominio que ya apunta a la IP del VPS (registro DNS tipo A).
DOMINIO="sysfact.ejemplo.com.py"
# Correo para avisos de Let's Encrypt (vencimiento del certificado).
EMAIL_CERTBOT="admin@ejemplo.com.py"

# --- Base de datos ---
DB_NAME="sysfact"
DB_USER="sysfact"

# --- Zona horaria del servidor y de la base ---
ZONA_HORARIA="America/Asuncion"

# --- Versiones (las mismas que en desarrollo) ---
WILDFLY_VERSION="26.1.3.Final"
PG_JDBC_VERSION="42.7.2"

# --- Memoria de WildFly (VPS de 4 GB) ---
WILDFLY_XMS="256m"
WILDFLY_XMX="1g"

# --- Rutas en el VPS ---
# Archivos que sube el sistema (logo de la empresa) y reportes.
SYSFACT_DATOS="/opt/sysfact"
# Carpeta que sirve nginx con el Angular compilado.
WEB_ROOT="/var/www/sysfact"
# Copias de seguridad diarias de la base.
BACKUP_DIR="/var/backups/sysfact"
# Días que se guardan las copias en el VPS.
BACKUP_DIAS="14"

# --- Rutas en tu máquina (para desplegar.sh) ---
BACKEND_DIR="/mnt/c/Users/User/OneDrive/Documentos/repo/be-sysfact"
FRONTEND_DIR="/home/aabenitez/repo/fe-sysfact"
